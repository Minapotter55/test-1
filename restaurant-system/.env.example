# انسخ الملف ده باسم .env وعدّل القيم لو محتاج

# البورت اللي السيستم هيشتغل عليه
PORT=3000

# 0.0.0.0 = يقبل اتصال من أي جهاز على نفس الشبكة (الموبايل مثلاً)
HOST=0.0.0.0

# مفتاح سري لتوقيع تسجيل الدخول - لو سبته فاضي السيستم هيولّد واحد تلقائي ويحفظه في data/.secret
JWT_SECRET=

# مدة صلاحية تسجيل الدخول
TOKEN_EXPIRES=7d

# مكان قاعدة البيانات
DB_FILE=data/restaurant.db

# المنطقة الزمنية للتقارير
TZ=Africa/Cairo
